NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://webgis:webgis_dev_password@localhost:5432/webgis
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:5173
AUTH_MODE=disabled

# Chỉ cần khi AUTH_MODE=supabase. Không đưa service-role key vào frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Secret key chỉ dùng trong backend để quản lý bucket ảnh private.
# Lấy tại Supabase Settings -> API Keys. Không commit giá trị thật.
SUPABASE_SECRET_KEY=sb_secret_your_key
SUPABASE_STORAGE_BUCKET=incident-attachments
